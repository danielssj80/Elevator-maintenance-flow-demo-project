# Copy to a .env at the REPO ROOT (not here) and fill in.
# `.env` is already covered by the `*.env` rule in .gitignore.
#
# Only needed for the Grafana Cloud overlay:
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
# The local stack works without any of these.

# From "OpenTelemetry" in the Grafana Cloud stack details. BASE url, with no
# /v1/traces suffix — the Collector appends the signal path itself.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp

# Numeric instance ID shown next to the OTLP endpoint.
GRAFANA_CLOUD_INSTANCE_ID=000000

# A Cloud Access Policy token with the metrics:write, logs:write and
# traces:write scopes.
GRAFANA_CLOUD_API_TOKEN=glc_replace_me

# --- Orchestration (n8n, M5) ---------------------------------------------
# All optional: docker-compose.yml carries working local-development defaults
# for each, so the stack comes up without any of them.

# Must be the same value for the n8n main process and every worker, or workers
# cannot decrypt credentials and every node using one fails with an error that
# never mentions encryption. Both read this one variable, so they agree by
# construction. Override the compose default with a real value here.
N8N_ENCRYPTION_KEY=replace_me

# `regular` (default) runs executions in the main process. `queue` requires the
# compose `queue` profile, which brings up redis and n8n-worker:
#   N8N_EXECUTIONS_MODE=queue docker compose --profile queue up -d
N8N_EXECUTIONS_MODE=regular

# --- Bedrock, for local development only ----------------------------------
# Production authenticates with the EC2 instance role and needs none of this.
# Locally there is no role, so without these the briefing endpoint answers
# source="fallback" and n8n's AI Agent node cannot reach a model.
#
# Create an IAM user and attach the EXISTING customer-managed policy
# `ElevatorBedrockInvokeNova` — the same one the instance role uses. Do not
# write a new policy: reusing it keeps local and production in step.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
BEDROCK_REGION=eu-north-1

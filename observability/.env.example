# Copy to a .env at the REPO ROOT (not here) and fill in.
# `.env` is already covered by the `*.env` rule in .gitignore.
#
# Only needed for the Grafana Cloud overlay:
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
# The local stack works without any of these.

# From "OpenTelemetry" in the Grafana Cloud stack details. BASE url, with no
# /v1/traces suffix — the Collector appends the signal path itself.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp

# Numeric instance ID shown next to the OTLP endpoint.
GRAFANA_CLOUD_INSTANCE_ID=000000

# A Cloud Access Policy token with the metrics:write, logs:write and
# traces:write scopes.
GRAFANA_CLOUD_API_TOKEN=glc_replace_me
